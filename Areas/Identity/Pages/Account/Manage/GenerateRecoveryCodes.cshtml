@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Générer des codes de récupération pour la 2FA";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Put these codes in a safe place.</strong>
    </p>
    <p>
        Si vous perdez votre appareil et que vous n’avez pas vos codes de récupération, vous perdrez l’accès à votre compte.
    </p>
    <p>
        La génération de nouveaux codes ne modifie pas les clés de votre application d’authentification. Pour changer la clé,
        vous devez <a asp-page="./ResetAuthenticator">réinitialiser vos clés d’authentification.</a>
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Generate Recovery Codes</button>
    </form>
</div>
