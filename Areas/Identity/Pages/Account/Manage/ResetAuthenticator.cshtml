@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Réinitialiser la clé d’authentification";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Après la réinitialisation, votre application d’authentification ne fonctionnera plus tant qu’elle n’aura pas été reconfigurée.</strong>
    </p>
    <p>
        Cette opération désactive la 2FA jusqu’à la vérification de votre application.
        Si vous ne terminez pas sa configuration, vous risquez de perdre l’accès à votre compte.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Réinitialiser la clé d’authentification</button>
    </form>
</div>
