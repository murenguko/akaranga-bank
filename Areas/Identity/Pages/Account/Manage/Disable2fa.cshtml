@page
@model Disable2faModel
@{
    ViewData["Title"] = "Désactiver l’authentification à deux facteurs (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>This action only disables 2FA.</strong>
    </p>
    <p>
        La désactivation de la 2FA ne modifie pas les clés utilisées par les applications d’authentification. Pour changer la clé,
        vous devez <a asp-page="./ResetAuthenticator">réinitialiser vos clés d’authentification.</a>
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Désactiver la 2FA</button>
    </form>
</div>
