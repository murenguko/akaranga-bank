@model IEnumerable<AkarangaBank.Web.Models.VirementInterAgence>
@{ ViewData["Title"] = "Historique des virements inter-agences"; }
<h1>Historique des virements inter-agences</h1><form method="get" class="row g-2 mb-3"><div class="col-auto"><input type="date" name="du" value="@(((DateTime?)ViewBag.Du)?.ToString("yyyy-MM-dd"))" class="form-control"/></div><div class="col-auto"><input type="date" name="au" value="@(((DateTime?)ViewBag.Au)?.ToString("yyyy-MM-dd"))" class="form-control"/></div><div class="col-auto"><button class="btn btn-primary">Filtrer</button></div></form><table class="table">
                <caption class="visually-hidden">@TableText["TableCaptionPrefix"] Date, Référence, Agences, Montant, Statut</caption><thead><tr><th scope="col">Date</th><th scope="col">Référence</th><th scope="col">Agences</th><th scope="col">Montant</th><th scope="col">Statut</th></tr></thead><tbody>@foreach(var v in Model){<tr><td>@v.DateCreation.ToLocalTime()</td><td>@v.Reference</td><td>@v.AgenceSource.Code → @v.AgenceDestination.Code</td><td>@v.Montant.ToString("N2") @v.Devise</td><td>@v.Statut</td></tr>}</tbody></table>
