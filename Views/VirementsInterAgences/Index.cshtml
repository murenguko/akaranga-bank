@model IEnumerable<AkarangaBank.Web.Models.VirementInterAgence>
@{ ViewData["Title"] = "Virements inter-agences en attente"; }
<h1>Virements inter-agences en attente</h1>
@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-danger">@err</div>}
<p><a asp-action="Initier" class="btn btn-primary">Nouveau virement</a> <a asp-action="Historique" class="btn btn-outline-secondary">Historique</a> <a asp-controller="Compensations" asp-action="Index" class="btn btn-outline-secondary">Compensations</a></p>
<table class="table table-striped">
                <caption class="visually-hidden">@TableText["TableCaptionPrefix"] Date, Référence, Agence source, Agence destination, Montant, Actions</caption><thead><tr><th scope="col">Date</th><th scope="col">Référence</th><th scope="col">Agence source</th><th scope="col">Agence destination</th><th scope="col">Montant</th><th scope="col">Actions</th></tr></thead><tbody>@foreach(var v in Model){<tr><td>@v.DateCreation.ToLocalTime().ToString("g")</td><td>@v.Reference</td><td>@v.AgenceSource.Code</td><td>@v.AgenceDestination.Code</td><td>@v.Montant.ToString("N2") @v.Devise</td><td>@if(User.IsInRole("admin")){<form asp-action="Valider" asp-route-id="@v.Id" method="post" class="d-inline"><button class="btn btn-sm btn-success">Valider</button></form><form asp-action="Rejeter" asp-route-id="@v.Id" method="post" class="d-inline"><input type="hidden" name="motif" value="Rejeté par un administrateur"/><button class="btn btn-sm btn-danger">Rejeter</button></form>}</td></tr>}</tbody></table>
