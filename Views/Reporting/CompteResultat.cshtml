@model AkarangaBank.Web.ViewModels.CompteResultatViewModel
@{
    ViewData["Title"] = "Compte de Résultat";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1" style="color: #1F3864;">Compte de Résultat Simplifié</h1>
        <p class="text-muted mb-0">Période du @Model.Du.ToString("d") au @Model.Au.ToString("d")</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print();" class="btn btn-outline-primary">
            <i class="bi bi-printer"></i> Imprimer
        </button>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Retour au tableau de bord</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Produits (Gains) -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-success text-white py-3">
                <h5 class="mb-0"><i class="bi bi-arrow-up-circle"></i> Produits Bancaires (Revenus)</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Intérêts et produits assimilés sur prêts</strong>
                            <div class="small text-muted">Intérêts perçus sur échéances de crédits amorties</div>
                        </div>
                        <span class="fw-bold">@Model.InteretsPerçusPrets.ToString("N2") BIF</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Commissions bancaires et frais de tenue</strong>
                            <div class="small text-muted">Frais de tenue de compte, virements interbancaires</div>
                        </div>
                        <span class="fw-bold">@Model.CommissionsEtFraisTenueCompte.ToString("N2") BIF</span>
                    </li>
                </ul>
                <div class="p-3 bg-light rounded d-flex justify-content-between align-items-center border">
                    <span class="h6 mb-0 text-success fw-bold">TOTAL DES PRODUITS</span>
                    <span class="h5 mb-0 text-success fw-bold">@Model.TotalProduits.ToString("N2") BIF</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Charges (Dépenses) -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0"><i class="bi bi-arrow-down-circle"></i> Charges Bancaires (Coûts)</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Intérêts servis sur l'épargne</strong>
                            <div class="small text-muted">Rémunération des comptes épargne (taux contractuels)</div>
                        </div>
                        <span class="fw-bold">@Model.InteretsVersesEpargne.ToString("N2") BIF</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Charges générales d'exploitation</strong>
                            <div class="small text-muted">Frais informatiques, télécoms, personnel</div>
                        </div>
                        <span class="fw-bold">@Model.ChargesExploitationEstimees.ToString("N2") BIF</span>
                    </li>
                </ul>
                <div class="p-3 bg-light rounded d-flex justify-content-between align-items-center border">
                    <span class="h6 mb-0 text-danger fw-bold">TOTAL DES CHARGES</span>
                    <span class="h5 mb-0 text-danger fw-bold">@Model.TotalCharges.ToString("N2") BIF</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Résultat Net -->
<div class="card shadow-sm border-0 mb-4 @(Model.ResultatNet >= 0 ? "border-start border-success border-5" : "border-start border-danger border-5")">
    <div class="card-body p-4 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-1" style="color: #1F3864;">RÉSULTAT NET D'EXPLOITATION (Produits - Charges)</h4>
            <p class="text-muted mb-0">Marge nette bancaire dégagée sur la période analysée.</p>
        </div>
        <div class="text-end">
            <div class="h2 mb-0 fw-bold @(Model.ResultatNet >= 0 ? "text-success" : "text-danger")">
                @Model.ResultatNet.ToString("N2") BIF
            </div>
            <span class="badge @(Model.ResultatNet >= 0 ? "bg-success" : "bg-danger")">
                @(Model.ResultatNet >= 0 ? "BÉNÉFICE NET" : "DÉFICIT")
            </span>
        </div>
    </div>
</div>
