@model IEnumerable<AkarangaBank.Web.Models.AlerteAML>
@{ ViewData["Title"] = "Alertes AML"; }
<h1>Alertes AML</h1>
<form method="get" class="row g-2 mb-3"><div class="col-auto"><select name="statut" class="form-select"><option value="">Tous les statuts</option>@foreach(var s in new[]{"Ouverte","EnCours","Traitee","Classee"}){<option selected="@(ViewBag.Statut==s)" value="@s">@s</option>}</select></div><div class="col-auto"><select name="niveau" class="form-select"><option value="">Tous les niveaux</option>@foreach(var n in new[]{"Faible","Moyen","Eleve","Critique"}){<option selected="@(ViewBag.Niveau==n)" value="@n">@n</option>}</select></div><div class="col-auto"><button class="btn btn-primary">Filtrer</button></div></form>
<table class="table table-striped">
                <caption class="visually-hidden">@TableText["TableCaptionPrefix"] Date, Client, Type, Niveau, Statut</caption><thead><tr><th scope="col">Date</th><th scope="col">Client</th><th scope="col">Type</th><th scope="col">Niveau</th><th scope="col">Statut</th><th scope="col"></th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.DateAlerte.ToLocalTime().ToString("g")</td><td>@a.Client.Nom @a.Client.Prenom</td><td>@a.TypeAlerte</td><td>@a.Niveau</td><td>@a.Statut</td><td><a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">Détails</a></td></tr>}</tbody></table>
