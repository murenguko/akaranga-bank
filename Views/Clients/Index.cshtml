@model IEnumerable<AkarangaBank.Web.Models.Client>
@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-1" style="color: #1F3864;">Répertoire des Clients</h1>
        <p class="text-muted mb-0">Gestion de la clientèle et vérification de conformité KYC.</p>
    </div>
    @if (User.IsInRole("guichetier") || User.IsInRole("gestionnaire") || User.IsInRole("admin"))
    {
        <a asp-action="Create" class="btn btn-primary" style="background-color: #1F3864;" aria-label="Nouveau client">
            <i class="bi bi-person-plus"></i> + Nouveau client
        </a>
    }
</div>

@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="recherche" value="@ViewBag.Recherche" class="form-control" placeholder="Rechercher par nom, prénom, n° client, CNI..." />
            </div>
            <div class="col-md-3">
                <select name="agenceId" class="form-select">
                    <option value="">Toutes les agences</option>
                    @foreach (var agence in (IEnumerable<AkarangaBank.Web.Models.Agence>)ViewBag.Agences)
                    {
                        <option value="@agence.Id" selected="@(ViewBag.AgenceId == agence.Id)">@agence.Code — @agence.Ville</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="statut" class="form-select">
                    <option value="">Tous les statuts</option>
                    <option value="Actif" selected="@(ViewBag.Statut == "Actif")">Actif</option>
                    <option value="Suspendu" selected="@(ViewBag.Statut == "Suspendu")">Suspendu</option>
                    <option value="Cloture" selected="@(ViewBag.Statut == "Cloture")">Clôturé</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100">Filtrer</button>
            </div>
        </form>
    </div>
</div>

@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Pagination des clients">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-recherche="@ViewBag.Recherche" asp-route-agenceId="@ViewBag.AgenceId" asp-route-statut="@ViewBag.Statut">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" role="table" aria-label="Liste des clients">
                <caption class="visually-hidden">@TableText["TableCaptionPrefix"] Liste des clients</caption>
                <thead class="table-light">
                    <tr>
                        <th scope="col">Numéro Client</th>
                        <th scope="col">Nom &amp; Prénom</th>
                        <th scope="col">CNI</th>
                        <th scope="col">Téléphone</th>
                        <th scope="col">Agence</th>
                        <th scope="col">Statut</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.NumeroClient</strong></td>
                        <td>@c.Nom @c.Prenom</td>
                        <td>@c.NumeroCNI</td>
                        <td>@(c.Telephone ?? "-")</td>
                        <td><span class="badge bg-light text-dark border">@c.Agence?.Code</span></td>
                        <td><span class="badge bg-success">@c.Statut</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Détails</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
