@model IEnumerable<AkarangaBank.Web.Models.CompensationAgence>
@{ ViewData["Title"] = "Compensations inter-agences"; }
<h1>Compensations inter-agences</h1>@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-danger">@err</div>}<div class="alert @((bool)ViewBag.Equilibre?"alert-success":"alert-warning")">@((bool)ViewBag.Equilibre?"Les totaux de compensation sont équilibrés.":"Les totaux de compensation ne sont pas équilibrés.")</div>
<form method="get" class="row g-2 mb-3"><div class="col-auto"><select name="agenceId" asp-items="ViewBag.Agences" class="form-select"><option value="">Toutes les agences</option></select></div><div class="col-auto"><input type="date" name="date" value="@ViewBag.Date" class="form-control"/></div><div class="col-auto"><button class="btn btn-outline-primary">Filtrer</button></div></form>
<form asp-action="Calculer" method="post" class="row g-2 mb-3"><div class="col-auto"><select name="agenceId" asp-items="ViewBag.Agences" class="form-select" required><option value="">Agence à calculer</option></select></div><div class="col-auto"><input type="date" name="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-auto"><button class="btn btn-primary">Calculer</button></div></form>
<table class="table table-striped">
                <caption class="visually-hidden">@TableText["TableCaptionPrefix"] Date, Référence, Agence, Débits, Crédits, Solde net, Statut</caption><thead><tr><th scope="col">Date</th><th scope="col">Référence</th><th scope="col">Agence</th><th scope="col">Débits</th><th scope="col">Crédits</th><th scope="col">Solde net</th><th scope="col">Statut</th><th scope="col"></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.DateCompensation.ToString("d")</td><td>@c.Reference</td><td>@c.Agence.Code</td><td>@c.TotalDebits.ToString("N2")</td><td>@c.TotalCredits.ToString("N2")</td><td>@c.Solde.ToString("N2")</td><td>@c.Statut</td><td>@if(c.Statut!="Regle"){<form asp-action="Regler" asp-route-id="@c.Id" method="post"><button class="btn btn-sm btn-success">Régler</button></form>}</td></tr>}</tbody></table>
