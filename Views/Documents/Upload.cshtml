@model AkarangaBank.Web.ViewModels.DocumentUploadViewModel
@{
    ViewData["Title"] = "Téléverser un document";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h1 class="h4 mb-0" style="color: #1F3864;"><i class="bi bi-file-earmark-arrow-up"></i> Téléversement Sécurisé de Document</h1>
            </div>
            <div class="card-body p-4">
                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Titre" class="form-label fw-semibold"></label>
                        <input asp-for="Titre" class="form-control" placeholder="Ex: CNI Recto-Verso - Emmanuel Nshimirimana" />
                        <span asp-validation-for="Titre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Fichier" class="form-label fw-semibold"></label>
                        <input asp-for="Fichier" type="file" class="form-control" />
                        <div class="form-text">Formats autorisés : PDF, JPG, PNG, DOCX, XLSX. Taille maximale : 10 Mo.</div>
                        <span asp-validation-for="Fichier" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Categorie" class="form-label fw-semibold"></label>
                        <select asp-for="Categorie" class="form-select">
                            <option value="KYC">KYC (Justificatif d'identité / domicile)</option>
                            <option value="Contrat">Contrat bancaire (Prêt, compte, caution)</option>
                            <option value="Comptable">Pièce comptable (Bordereau, ordre de transfert)</option>
                            <option value="AML">Dossier de conformité LBC/FT</option>
                            <option value="RH">Ressources humaines</option>
                            <option value="Audit">Rapport d'audit / Contrôle interne</option>
                        </select>
                        <span asp-validation-for="Categorie" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" />
                    <h6 class="text-muted mb-3">Rattachements optionnels</h6>

                    <div class="mb-3">
                        <label asp-for="ClientId" class="form-label"></label>
                        <select asp-for="ClientId" asp-items="ViewBag.Clients" class="form-select">
                            <option value="">-- Aucun client spécifique --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CompteId" class="form-label"></label>
                        <select asp-for="CompteId" asp-items="ViewBag.Comptes" class="form-select">
                            <option value="">-- Aucun compte spécifique --</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PretId" class="form-label"></label>
                        <select asp-for="PretId" asp-items="ViewBag.Prets" class="form-select">
                            <option value="">-- Aucun dossier de prêt spécifique --</option>
                        </select>
                    </div>

                    <div class="alert alert-light border small text-muted">
                        <i class="bi bi-shield-lock"></i> Les fichiers sont stockés hors du répertoire racine web accessible par URL, avec calcul automatique d'une empreinte cryptographique SHA-256 garantissant l'intégrité probante du fichier.
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary" style="background-color: #1F3864; border-color: #1F3864;">
                            <i class="bi bi-upload"></i> Téléverser le document
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
