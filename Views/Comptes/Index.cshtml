@model IEnumerable<AkarangaBank.Web.Models.Compte>
@{
    ViewData["Title"] = "Comptes Bancaires";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-1" style="color: #1F3864;">Comptes Bancaires</h1>
        <p class="text-muted mb-0">Gestion des comptes courants, épargne et crédits.</p>
    </div>
    @if (User.IsInRole("gestionnaire") || User.IsInRole("admin"))
    {
        <a asp-action="Create" class="btn btn-primary" style="background-color: #1F3864;" aria-label="Ouvrir un compte">
            <i class="bi bi-wallet-plus"></i> + Ouvrir un compte
        </a>
    }
</div>

@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}

@if (ViewBag.RequiresClientLink == true)
{
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h2 class="h5">Associer votre dossier client</h2>
            <p class="text-muted">Pour afficher vos comptes, saisissez les références de votre dossier client. Elles doivent correspondre aux informations enregistrées par votre agence et à l’adresse e-mail de ce compte utilisateur.</p>
            <form asp-action="LierMonDossier" method="post" class="row g-3">
                <div class="col-md-5">
                    <label for="numeroClient" class="form-label">Numéro client</label>
                    <input id="numeroClient" name="numeroClient" class="form-control" autocomplete="off" required />
                </div>
                <div class="col-md-5">
                    <label for="numeroCni" class="form-label">Numéro de CNI</label>
                    <input id="numeroCni" name="numeroCni" class="form-control" autocomplete="off" required />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Vérifier</button>
                </div>
            </form>
        </div>
    </div>
}
else
{
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="recherche" value="@ViewBag.Recherche" class="form-control" placeholder="Numéro compte, client..." />
            </div>
            <div class="col-md-3">
                <select name="agenceId" class="form-select">
                    <option value="">Toutes les agences</option>
                    @foreach (var agence in (IEnumerable<AkarangaBank.Web.Models.Agence>)ViewBag.Agences)
                    {
                        <option value="@agence.Id" selected="@(ViewBag.AgenceId == agence.Id)">@agence.Code — @agence.Ville</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="statut" class="form-select">
                    <option value="">Tous les statuts</option>
                    <option value="Actif" selected="@(ViewBag.Statut == "Actif")">Actif</option>
                    <option value="Bloque" selected="@(ViewBag.Statut == "Bloque")">Bloqué</option>
                    <option value="Cloture" selected="@(ViewBag.Statut == "Cloture")">Clôturé</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-secondary w-100">Filtrer</button>
            </div>
        </form>
    </div>
</div>

@if ((int)ViewBag.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Pagination des comptes">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-recherche="@ViewBag.Recherche" asp-route-agenceId="@ViewBag.AgenceId" asp-route-statut="@ViewBag.Statut">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" role="table" aria-label="Liste des comptes bancaires">
                <caption class="visually-hidden">@TableText["TableCaptionPrefix"] Liste des comptes bancaires</caption>
                <thead class="table-light">
                    <tr>
                        <th scope="col">Numéro de Compte</th>
                        <th scope="col">Titulaire</th>
                        <th scope="col">Type</th>
                        <th scope="col">Agence</th>
                        <th scope="col" class="text-end">Solde Actuel</th>
                        <th scope="col">Statut</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="font-monospace fw-bold">@c.NumeroCompte</td>
                        <td>
                            @if (c.Client != null)
                            {
                                <a asp-controller="Clients" asp-action="Details" asp-route-id="@c.ClientId">
                                    @c.Client.Nom @c.Client.Prenom
                                </a>
                            }
                            else
                            {
                                <span>Compte Général</span>
                            }
                        </td>
                        <td><span class="badge bg-light text-dark border">@c.TypeCompte?.Libelle</span></td>
                        <td><span class="badge bg-light text-dark border">@c.Agence?.Code</span></td>
                        <td class="text-end fw-bold text-primary">@c.Solde.ToString("N2") @c.Devise</td>
                        <td><span class="badge bg-success">@c.Statut</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Détails</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
}
