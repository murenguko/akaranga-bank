@model IEnumerable<AkarangaBank.Web.Models.AuditLog> 
@{ ViewData["Title"] = "Piste d'audit"; } 
 
<h1>Piste d'audit</h1> 
 
<form method="get" class="row g-2 mb-3"> 
    <div class="col-md-3"> 
        <input type="text" name="action" value="@ViewBag.Action" 
               class="form-control" placeholder="Action..." /> 
    </div> 
    <div class="col-md-3"> 
        <input type="text" name="table" value="@ViewBag.Table" 
               class="form-control" placeholder="Table..." /> 
    </div> 
    <div class="col-md-2"> 
        <input type="date" name="du" value="@ViewBag.Du?.ToString("yyyy-MM-dd")" 
               class="form-control" /> 
    </div> 
    <div class="col-md-2"> 
        <input type="date" name="au" value="@ViewBag.Au?.ToString("yyyy-MM-dd")" 
               class="form-control" /> 
    </div> 
    <div class="col-md-2"> 
        <button type="submit" class="btn btn-primary">Filtrer</button> 
    </div> 
</form> 

 
<table class="table table-striped table-sm">
                <caption class="visually-hidden">@TableText["TableCaptionPrefix"] Date, Utilisateur, Action, Table, IP</caption> 
    <thead> 
        <tr> 
            <th scope="col">Date</th> 
            <th scope="col">Utilisateur</th> 
            <th scope="col">Action</th> 
            <th scope="col">Table</th> 
            <th scope="col">IP</th> 
            <th scope="col"></th> 
        </tr> 
    </thead> 
    <tbody> 
    @foreach (var log in Model) 
    { 
        <tr> 
            <td>@log.DateEvenement.ToString("G")</td> 
            <td>@(log.Utilisateur?.Email ?? "—")</td> 
            <td>@log.Action</td> 
            <td>@log.TableConcernee</td> 
            <td>@log.AdresseIP</td> 
            <td> 
                <a asp-action="Details" asp-route-id="@log.Id" 
                   class="btn btn-sm btn-primary">Détails</a> 
            </td> 
        </tr> 
    } 
    </tbody> 
</table> 