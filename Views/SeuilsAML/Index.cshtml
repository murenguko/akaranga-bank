@model IEnumerable<AkarangaBank.Web.Models.SeuilAML>
@{ ViewData["Title"] = "Seuils AML"; }
<h1>Seuils AML</h1>@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}@if(TempData["Error"] is string err){<div class="alert alert-danger">@err</div>}<table class="table table-striped">
                <caption class="visually-hidden">@TableText["TableCaptionPrefix"] Règle, Opération, Seuil (BIF), Actif, Modifier</caption><thead><tr><th scope="col">Règle</th><th scope="col">Opération</th><th scope="col">Seuil (BIF)</th><th scope="col">Actif</th><th scope="col">Modifier</th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Libelle <small class="text-muted">(@s.Code)</small></td><td>@s.TypeOperation</td><td>@s.Montant.ToString("N2")</td><td>@(s.Actif?"Oui":"Non")</td><td><form asp-action="Modifier" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@s.Id"/><input type="number" name="montant" min="0.01" step="0.01" value="@s.Montant" class="form-control"/><button class="btn btn-primary">Enregistrer</button></form></td></tr>}</tbody></table>
