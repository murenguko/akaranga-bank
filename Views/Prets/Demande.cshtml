@model AkarangaBank.Web.ViewModels.PretDemandeViewModel
@{
    ViewData["Title"] = "Nouvelle demande de prêt";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h1 class="h4 mb-0" style="color: #1F3864;"><i class="bi bi-file-earmark-plus"></i> Demande de Prêt Bancaire</h1>
            </div>
            <div class="card-body p-4">
                <form asp-action="Demande" method="post" id="formPret">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="ClientId" class="form-label fw-semibold"></label>
                        <select asp-for="ClientId" asp-items="ViewBag.Clients" class="form-select" id="selectClient">
                            <option value="">-- Choisir un client éligible --</option>
                        </select>
                        <span asp-validation-for="ClientId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CompteDebitId" class="form-label fw-semibold"></label>
                        <select asp-for="CompteDebitId" asp-items="ViewBag.Comptes" class="form-select">
                            <option value="">-- Choisir le compte associé pour déblocage &amp; débit --</option>
                        </select>
                        <span asp-validation-for="CompteDebitId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="TypePret" class="form-label fw-semibold"></label>
                            <select asp-for="TypePret" class="form-select" id="typePret">
                                <option value="Consommation">Prêt à la consommation (12% / an)</option>
                                <option value="Immobilier">Crédit immobilier (9.5% / an)</option>
                                <option value="Equipement">Crédit d'équipement (11% / an)</option>
                                <option value="Commercial">Avance commerciale (14% / an)</option>
                            </select>
                            <span asp-validation-for="TypePret" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TauxIndicatif" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="TauxIndicatif" class="form-control" id="tauxInput" type="number" step="0.1" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="TauxIndicatif" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Montant" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Montant" class="form-control" id="montantInput" type="number" step="10000" />
                                <span class="input-group-text">BIF</span>
                            </div>
                            <span asp-validation-for="Montant" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DureeMois" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="DureeMois" class="form-control" id="dureeInput" type="number" min="3" max="120" />
                                <span class="input-group-text">mois</span>
                            </div>
                            <span asp-validation-for="DureeMois" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-info d-flex justify-content-between align-items-center my-4">
                        <div>
                            <strong>Simulation financière instantanée :</strong>
                            <div class="small">Amortissement constant à mensualités fixes</div>
                        </div>
                        <div class="text-end">
                            <div class="h4 mb-0 text-primary fw-bold" id="mensualiteAffichee">-- BIF / mois</div>
                            <small class="text-muted" id="coutTotalAffiche">Coût total : -- BIF</small>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Commentaire" class="form-label fw-semibold"></label>
                        <textarea asp-for="Commentaire" class="form-control" rows="3" placeholder="Description de l'objet du crédit ou garanties présentées..."></textarea>
                        <span asp-validation-for="Commentaire" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary" style="background-color: #1F3864; border-color: #1F3864;">
                            <i class="bi bi-send-check"></i> Soumettre la demande
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function recalculerMensualite() {
            const P = parseFloat(document.getElementById('montantInput').value) || 0;
            const taux = parseFloat(document.getElementById('tauxInput').value) || 0;
            const n = parseInt(document.getElementById('dureeInput').value) || 1;

            if (P <= 0 || n <= 0) {
                document.getElementById('mensualiteAffichee').innerText = '-- BIF / mois';
                document.getElementById('coutTotalAffiche').innerText = 'Coût total : -- BIF';
                return;
            }

            let M = 0;
            if (taux <= 0) {
                M = P / n;
            } else {
                const r = (taux / 100) / 12;
                M = P * (r / (1 - Math.pow(1 + r, -n)));
            }

            const total = M * n;
            document.getElementById('mensualiteAffichee').innerText = Math.round(M).toLocaleString('fr-FR') + ' BIF / mois';
            document.getElementById('coutTotalAffiche').innerText = 'Coût total : ' + Math.round(total).toLocaleString('fr-FR') + ' BIF';
        }

        document.getElementById('typePret').addEventListener('change', function() {
            const val = this.value;
            const tInput = document.getElementById('tauxInput');
            if (val === 'Consommation') tInput.value = 12.0;
            else if (val === 'Immobilier') tInput.value = 9.5;
            else if (val === 'Equipement') tInput.value = 11.0;
            else if (val === 'Commercial') tInput.value = 14.0;
            recalculerMensualite();
        });

        document.getElementById('montantInput').addEventListener('input', recalculerMensualite);
        document.getElementById('tauxInput').addEventListener('input', recalculerMensualite);
        document.getElementById('dureeInput').addEventListener('input', recalculerMensualite);
        recalculerMensualite();
    </script>
}
