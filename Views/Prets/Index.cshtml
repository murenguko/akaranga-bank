@model AkarangaBank.Web.ViewModels.PretListViewModel
@{
    ViewData["Title"] = "Prêts et Financements";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-1" style="color: #1F3864;">Gestion des Prêts et Financements</h1>
        <p class="text-muted mb-0">Cycle de vie des crédits, échéanciers d'amortissement et recouvrement.</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("gestionnaire") || User.IsInRole("admin"))
        {
            <form asp-action="ActualiserRetards" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-warning" aria-label="Actualiser les échéances en retard">
                    <i class="bi bi-clock-history"></i> Détecter les retards
                </button>
            </form>
        }
        @if (User.IsInRole("guichetier") || User.IsInRole("gestionnaire") || User.IsInRole("admin"))
        {
            <a asp-action="Demande" class="btn btn-primary" style="background-color: #1F3864; border-color: #1F3864;" aria-label="Créer une nouvelle demande de prêt">
                <i class="bi bi-plus-circle"></i> + Nouvelle demande
            </a>
        }
    </div>
</div>

@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @msg
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @err
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label for="recherche" class="form-label small text-muted">Rechercher</label>
                <input type="text" id="recherche" name="recherche" value="@Model.Recherche" class="form-control" placeholder="Réf, client, n° compte..." />
            </div>
            <div class="col-md-3">
                <label for="typePret" class="form-label small text-muted">Type de prêt</label>
                <select id="typePret" name="typePret" class="form-select">
                    <option value="">Tous les types</option>
                    <option value="Consommation" selected="@(Model.TypePret == "Consommation")">Consommation</option>
                    <option value="Immobilier" selected="@(Model.TypePret == "Immobilier")">Immobilier</option>
                    <option value="Equipement" selected="@(Model.TypePret == "Equipement")">Équipement</option>
                    <option value="Commercial" selected="@(Model.TypePret == "Commercial")">Commercial</option>
                </select>
            </div>
            <div class="col-md-3">
                <label for="statut" class="form-label small text-muted">Statut</label>
                <select id="statut" name="statut" class="form-select">
                    <option value="">Tous les statuts</option>
                    <option value="EnAttente" selected="@(Model.Statut == "EnAttente")">En attente</option>
                    <option value="Valide" selected="@(Model.Statut == "Valide")">Validé</option>
                    <option value="EnCours" selected="@(Model.Statut == "EnCours")">En cours</option>
                    <option value="Solde" selected="@(Model.Statut == "Solde")">Soldé</option>
                    <option value="Impaye" selected="@(Model.Statut == "Impaye")">Impayé</option>
                    <option value="Rejete" selected="@(Model.Statut == "Rejete")">Rejeté</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-secondary w-100" aria-label="Filtrer les prêts">
                    <i class="bi bi-funnel"></i> Filtrer
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" role="table" aria-label="Tableau des prêts bancaires">
                <caption class="visually-hidden">@TableText["TableCaptionPrefix"] Tableau des prêts bancaires</caption>
                <thead class="table-light">
                    <tr>
                        <th scope="col">Référence</th>
                        <th scope="col">Client</th>
                        <th scope="col">Type</th>
                        <th scope="col" class="text-end">Montant</th>
                        <th scope="col">Taux</th>
                        <th scope="col">Durée</th>
                        <th scope="col" class="text-end">Mensualité</th>
                        <th scope="col">Statut</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Prets.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">Aucun dossier de prêt trouvé.</td>
                    </tr>
                }
                else
                {
                    @foreach (var pret in Model.Prets)
                    {
                        <tr>
                            <td>
                                <strong>@pret.Reference</strong>
                                <div class="small text-muted">@pret.DateDemande.ToString("d")</div>
                            </td>
                            <td>
                                <a asp-controller="Clients" asp-action="Details" asp-route-id="@pret.ClientId" class="text-decoration-none">
                                    @pret.Client.Nom @pret.Client.Prenom
                                </a>
                                <div class="small text-muted">@pret.CompteDebit.NumeroCompte</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@pret.TypePret</span>
                            </td>
                            <td class="text-end fw-bold">
                                @pret.MontantPrincipal.ToString("N2") BIF
                            </td>
                            <td>@pret.TauxInteret.ToString("0.00") %</td>
                            <td>@pret.DureeMois mois</td>
                            <td class="text-end text-primary fw-semibold">
                                @pret.Mensualite.ToString("N2") BIF
                            </td>
                            <td>
                                @if (pret.Statut == "EnAttente")
                                {
                                    <span class="badge bg-warning text-dark">En attente</span>
                                }
                                else if (pret.Statut == "Valide")
                                {
                                    <span class="badge bg-info text-dark">Validé</span>
                                }
                                else if (pret.Statut == "EnCours")
                                {
                                    <span class="badge bg-primary">En cours</span>
                                }
                                else if (pret.Statut == "Solde")
                                {
                                    <span class="badge bg-success">Soldé</span>
                                }
                                else if (pret.Statut == "Impaye")
                                {
                                    <span class="badge bg-danger">Impayé</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Rejeté</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@pret.Id" class="btn btn-sm btn-outline-primary" aria-label="Voir le détail du prêt @pret.Reference">
                                    Détails &amp; Échéancier
                                </a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Pagination des prêts">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-recherche="@Model.Recherche" asp-route-statut="@Model.Statut" asp-route-typePret="@Model.TypePret">@i</a>
                </li>
            }
        </ul>
    </nav>
}
