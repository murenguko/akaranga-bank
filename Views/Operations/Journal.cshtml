@model AkarangaBank.Web.ViewModels.JournalViewModel
@{ ViewData["Title"] = "Journal comptable"; }
<h1>Journal comptable</h1>
@if (TempData["Success"] is string msg) { <div class="alert alert-success">@msg</div> }
<form method="get" class="row g-2 mb-3"><div class="col-auto"><label class="form-label">Du</label><input type="date" name="du" value="@Model.Du?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-auto"><label class="form-label">Au</label><input type="date" name="au" value="@Model.Au?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-auto"><label class="form-label">Type</label><select name="typeOperation" class="form-select"><option value="">Tous</option>@foreach(var t in new[]{"Depot","Retrait","Virement","VirementInterAgence"}){<option selected="@(Model.TypeOperation==t)" value="@t">@t</option>}</select></div><div class="col-auto align-self-end"><button class="btn btn-primary">Filtrer</button></div></form>
<table class="table table-striped">
                <caption class="visually-hidden">@TableText["TableCaptionPrefix"] Date, Référence, Type, Compte, Utilisateur, Montant, Statut</caption><thead><tr><th scope="col">Date</th><th scope="col">Référence</th><th scope="col">Type</th><th scope="col">Compte</th><th scope="col">Utilisateur</th><th scope="col">Montant</th><th scope="col">Statut</th><th scope="col"></th></tr></thead><tbody>
@foreach(var o in Model.Operations){<tr><td>@o.DateOperation.ToLocalTime().ToString("g")</td><td>@o.Reference</td><td>@o.TypeOperation</td><td>@o.Compte.NumeroCompte</td><td>@o.Utilisateur.NomComplet</td><td class="text-end">@o.Montant.ToString("N2") @o.Devise</td><td>@o.Statut</td><td><a asp-action="Releve" asp-route-id="@o.CompteId">Relevé</a></td></tr>}
</tbody></table>
@if(Model.TotalPages>1){<nav><ul class="pagination">@for(var p=1;p<=Model.TotalPages;p++){<li class="page-item @(p==Model.Page?"active":"")"><a class="page-link" asp-action="Journal" asp-route-page="@p" asp-route-du="@Model.Du?.ToString("yyyy-MM-dd")" asp-route-au="@Model.Au?.ToString("yyyy-MM-dd")" asp-route-typeOperation="@Model.TypeOperation">@p</a></li>}</ul></nav>}
