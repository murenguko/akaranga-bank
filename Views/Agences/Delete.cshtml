@model AkarangaBank.Web.Models.Agence
@{
 ViewData["Title"] = "Supprimer l'agence";
}
<h1>Supprimer l'agence</h1>
<div class="alert alert-warning">
 Confirmez-vous la suppression de cette agence ?
</div>
<dl class="row">
 <dt class="col-sm-3">Code</dt>
 <dd class="col-sm-9">@Model.Code</dd>
 <dt class="col-sm-3">Nom</dt>
 <dd class="col-sm-9">@Model.Nom</dd>
 <dt class="col-sm-3">Ville</dt>
 <dd class="col-sm-9">@Model.Ville</dd>
</dl>
<form asp-action="Delete" method="post">
 <input type="hidden" asp-for="Id" />
 <button type="submit" class="btn btn-danger">Supprimer</button>
 <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>
