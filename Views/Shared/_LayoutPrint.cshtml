<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Akaranga Bank Impression</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #ffffff;
            color: #000000;
            font-size: 11pt;
            padding: 15mm;
        }
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0 !important; }
        }
    </style>
</head>
<body>
    <div class="no-print mb-4 p-3 bg-light border rounded d-flex justify-content-between align-items-center">
        <div>
            <strong>Mode Impression de Rapport</strong> — Optimisé pour le format A4.
        </div>
        <div>
            <button onclick="window.print();" class="btn btn-primary" style="background-color: #1F3864;">
                <i class="bi bi-printer"></i> Imprimer ce document (Ctrl+P)
            </button>
            <button onclick="window.history.back();" class="btn btn-outline-secondary ms-2">
                Fermer
            </button>
        </div>
    </div>

    <div class="print-container">
        <header class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
            <div>
                <h2 class="mb-0 fw-bold" style="color: #1F3864;">AKARANGA BANK</h2>
                <small class="text-muted">Système Bancaire Central — Direction Financière</small>
            </div>
            <div class="text-end">
                <span class="badge border text-dark" style="border-color: #C9A227 !important;">DOCUMENT OFFICIEL</span>
                <div class="small text-muted mt-1">Édité le @DateTime.UtcNow.ToString("g") UTC</div>
            </div>
        </header>

        <main role="main">
            @RenderBody()
        </main>

        <footer class="mt-5 pt-3 border-top text-center text-muted small">
            Akaranga Bank S.A. &copy; @DateTime.UtcNow.Year — Tous droits réservés. Confidentialité et Secret Bancaire.
        </footer>
    </div>
</body>
</html>
